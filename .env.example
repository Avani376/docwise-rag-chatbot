# Optional: enables synthesized responses through the OpenAI API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local sentence-transformers model used to embed questions and passages.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Tune against your own evaluation set; higher thresholds abstain more often.
SIMILARITY_THRESHOLD=0.39

# Optional custom index location. Defaults to data/vectors.sqlite3.
# VECTOR_DB_PATH=

# "session" keeps browser sessions isolated (recommended for shared hosts).
# Use "persistent" only for a private, single-user local installation.
DOCWISE_LIBRARY_MODE=session
